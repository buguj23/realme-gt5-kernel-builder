# Overlay on Action-Build OEM OGKI gki_defconfig (kalama).
# NEVER applied to Google generic GKI. NEVER used as a standalone defconfig.
# YukiSU LKM (depends on m — builtin CONFIG_KSU=y is invalid)
CONFIG_KSU=m
CONFIG_KSU_SUPERKEY=y
CONFIG_KSU_YUKIZYGISK=y
CONFIG_KSU_DEBUG=n
CONFIG_KSU_SUSFS=n
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG_ALL=n
CONFIG_MODULE_SIG_FORCE=n
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_HAVE_SYSCALL_TRACEPOINTS=y
CONFIG_BPF_EVENTS=y

# Optional injector
CONFIG_REKERNEL=n
CONFIG_REKERNEL_NETWORK=n

# ZRAM lz4kd (enable with APPLY_ZRAM=1)
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_LZ4K=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CRYPTO_842=y
CONFIG_CRYPTO_LZ4K_OPLUS=y
CONFIG_ZRAM=m
CONFIG_ZRAM_WRITEBACK=y

# Lightweight containers (DroidSpaces / MidAS)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BINFMT_MISC=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_MACVLAN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=65534
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_BPF_STREAM_PARSER=y

# Network
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_TCP_ECN=y
