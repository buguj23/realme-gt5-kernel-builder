# Realme GT5 (`5.15.149`) Kernel & OGKI Configuration Fragment
#
# This overlay preserves stock `gki_defconfig` KMI compatibility (`module_layout = 0x0222dd63`,
# `android13-5.15`), while guaranteeing the capabilities required by AOSP / LineageOS / Infinity-X 15
# and YukiSU LKM (`CONFIG_KSU=m`).

# Hard KMI & OGKI constraints:
# - NEVER set CONFIG_KSU=y (YukiSU supports CONFIG_KSU=m LKM only).
# - NEVER enable SUSFS (mutates task_struct/fs structs and breaks stock module KMI CRCs).
# - NEVER enable KPM / KPN binary patching.
# - NEVER apply FakeConfig hiding these options from /proc/config.gz.

CONFIG_HEADERS_INSTALL=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_HAVE_SYSCALL_TRACEPOINTS=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_OVERLAY_FS=y
CONFIG_COMPAT=y
CONFIG_ZSMALLOC=m
CONFIG_ZRAM=m
