# Minimal overlay for a module-compatible (stock-ABI) kernel.
#
# The baseline is the ROM's own IKCONFIG (configs/stock/<rom>.config), which already
# provides everything YukiSU needs: CONFIG_MODULES=y, MODULE_UNLOAD=y,
# KPROBES=y, KRETPROBES=y, HAVE_SYSCALL_TRACEPOINTS=y, KALLSYMS_ALL=y, COMPAT=y,
# and MODULE_SIG_FORCE unset. Adding anything else risks changing a type that an
# exported symbol's CRC is computed from, which is exactly what decides whether the
# stock vendor_dlkm modules load into this kernel.
#
# So: KSU only. No netfilter/cgroup/crypto/ZRAM feature lines here - those belong to
# configs/features.config, used by the feature build.
CONFIG_KSU=m
CONFIG_KSU_SUPERKEY=y
CONFIG_KSU_YUKIZYGISK=y
CONFIG_KSU_DEBUG=n
CONFIG_KSU_SUSFS=n
