<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gt5.halotile"
    android:versionCode="120"
    android:versionName="1.2.0">

    <uses-sdk
        android:minSdkVersion="31"
        android:targetSdkVersion="33" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_halo_tile"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <service
            android:name=".HaloTileService"
            android:exported="true"
            android:icon="@drawable/ic_halo_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name=".TileSyncReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.gt5.halotile.ACTION_SYNC" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".QuickControlActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleInstance"
            android:theme="@style/HaloDialogTheme">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>
</manifest>
