on early-init
    write /proc/sys/kernel/sched_tunable_scaling 0

# Disarm OPLUS Phoenix 250s boot watchdog (oplus_phoenix.ko is loaded in vendor_boot
# and bootloader passes phx_rus_conf.main_on=1 buildvariant=user).
on post-fs
    write /proc/phoenix "SET_BOOTSTAGE@NATIVE_INIT_POST_FS"

on property:sys.boot_completed=1
    write /proc/phoenix "SET_BOOTSTAGE@ANDROID_BOOT_COMPLETED"
    write /proc/phoenix "SET_BOOTSTAGE@PHOENIX_BOOT_COMPLETED"
