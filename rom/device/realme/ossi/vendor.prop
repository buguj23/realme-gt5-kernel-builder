# Bluetooth
bluetooth.device.default_name=realme GT5

# Graphics
ro.surface_flinger.set_idle_timer_ms=250
ro.surface_flinger.set_touch_timer_ms=300

# USB
vendor.usb.product_string=realme GT5

# Biometrics / Under-Display Optical Fingerprint (UFF G_OPTICAL_G3S)
persist.vendor.fingerprint.fp_id=G_OPTICAL_G3S
persist.vendor.fingerprint.optical.sensorlocation=620::2516
persist.vendor.fingerprint.optical.iconsize=195
persist.vendor.fingerprint.optical.sensorrotation=83.5
persist.vendor.fingerprint.optical.support=1
persist.vendor.fingerprint.sensor_type=optical
persist.vendor.fingerprint.version=UFF V1.0.0.0
vendor.fingerprint.aidl.support=1
